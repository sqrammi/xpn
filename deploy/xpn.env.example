PUBLIC_URL=https://vpn.example.com/xpn
# Generate independently: openssl rand -hex 32
MASTER_KEY=REPLACE_WITH_64_HEX_CHARACTERS
ADMIN_TOKEN=REPLACE_WITH_A_DIFFERENT_RANDOM_64_HEX_VALUE
DATA_DIR=/var/lib/xpn
CONTROL_SOCKET=/run/xpn/control.sock
PORT=3000
# Optional defaults for NEW device profiles. SNI requires at least one pin.
# Pins are SHA-256 fingerprints of nginx's leaf certificate (not its CA).
# VPN_SNI=app.jeffhansen.com
# VPN_CERTIFICATE_PINS=64_HEX_DIGIT_FINGERPRINT[,SECOND_FINGERPRINT_FOR_ROTATION]
# Optional. URL-encode special characters in SMTP credentials. STARTTLS is required.
# SMTP_URL=smtps://username:password@smtp.example.com:465
# SMTP_FROM=XPN <vpn@example.com>
