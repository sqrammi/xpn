[Unit]
Description=XPN persistent TUN and forwarding rules
After=network-online.target
Wants=network-online.target
Before=xpn-native.service xpn-gateway.service
Wants=xpn-gateway.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/xpn/deploy/network.sh
ExecStop=/opt/xpn/deploy/network.sh stop

[Install]
WantedBy=multi-user.target
