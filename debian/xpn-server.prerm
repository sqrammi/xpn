#!/bin/sh
set -eu
case "$1" in
    remove|deconfigure|upgrade)
        if [ -d /run/systemd/system ]; then
            # Updates deliberately stop the tunnel; explicit restart follows validation.
            deb-systemd-invoke stop xpn-native.service xpn-control.service xpn-network.service || true
        fi
        ;;
esac
#DEBHELPER#
